# Copy to .env and fill in.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 1 = return cached/fake Gemini extractions (no API calls). Useful offline & for demo safety.
DEMO_MODE=1
FLASK_DEBUG=1
PORT=8050
# Optional (secondary feature)
TELEGRAM_BOT_TOKEN=

# Firebase Firestore Persistence (Optional for local dev, automatic in Cloud Run)
USE_FIREBASE=1
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_COLLECTION=investpi_reports
