# Copy to .env and fill in.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# 0 = live Gemini API extractions, 1 = offline test mock extractions
DEMO_MODE=0
FLASK_DEBUG=1
PORT=8050
# Optional (secondary feature)
TELEGRAM_BOT_TOKEN=

# GCP & Firebase Firestore Persistence
GCP_PROJECT_ID=investpi-builderscup-0000
USE_FIREBASE=1
FIREBASE_PROJECT_ID=investpi-builderscup-0000
FIREBASE_CREDENTIALS_PATH=
FIREBASE_COLLECTION=investpi_reports

# Google Cloud Pub/Sub Configuration
PUBSUB_TOPIC_LEADS=investpi-leads-inbound
PUBSUB_TOPIC_AUDITS=investpi-audits-completed
PUBSUB_TOPIC_SYNC=investpi-market-sync
